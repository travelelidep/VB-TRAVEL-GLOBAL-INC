# VB TRAVEL GLOBAL INC - Variables de entorno
# Copia este archivo a .env.local para desarrollo y configúralas en Render.

# --- Célula de agentes IA (opcional: sin clave funciona en modo reglas) ---
# Compatible con OpenAI, Groq, OpenRouter o cualquier API estilo OpenAI.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Planificador interno (cada 15 min). Ponlo en false para desactivarlo.
AUTOMATION_SELF_SCHEDULE=true

# Secreto para invocar /api/automation/tick desde un cron externo.
CRON_SECRET=cambia-este-secreto

# --- Persistencia del estado de los agentes (opcional) ---
# Sin Redis el estado vive en memoria del proceso (se reinicia con el deploy).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=58416111157
NEXT_PUBLIC_EMAIL=vbtravelglobal@gmail.com

# --- WhatsApp Business API ---
WHATSAPP_VERIFY_TOKEN=vbtravelglobal_verify_2024
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=sistema@vbtravelglobal.com

# --- WINGS (reservas) ---
WINGS_WEBHOOK_SECRET=

# --- CRM (Airtable) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- Catálogo de productos ---
# Sin estas variables el sitio usa el catálogo local (src/lib/products/catalogo.ts).
# Con ellas, /api/products consulta la fuente remota (Alibaba, proxy propio, etc.).
PRODUCTOS_API_URL=
PRODUCTOS_API_KEY=
