# MD Travel Global - Variables de Entorno
# Copia este archivo a .env.local y completa los valores

# WINGS Integration
WINGS_WEBHOOK_SECRET=tu_secreto_webhook_aqui
WINGS_AGENT_REF=MDTRAVEL_WEB

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=sistema@mdtravelglobal.com

# CRM (Airtable example)
AIRTABLE_API_KEY=pat_xxxxxxxxxxxxx
AIRTABLE_BASE_ID=app_xxxxxxxxxxxxx

# WhatsApp Business API (opcional)
WHATSAPP_TOKEN=tu_token_whatsapp
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id

# Next.js
NEXT_PUBLIC_SITE_URL=https://tudominio.com
